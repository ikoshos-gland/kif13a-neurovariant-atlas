# Copy to .env, fill in what you have, then run:  python mcp/setup_mcp.py
# Every key is optional; servers work without them, some with lower limits or fewer tools.

# NCBI E-utilities: 3 -> 10 requests/s (ClinVar, PubMed, gnomAD ClinVar tool)
# https://account.ncbi.nlm.nih.gov/settings/  (API Key Management)
NCBI_API_KEY=

# OpenAlex needs no key (keyless: 1000 credits/day, one search = 10 credits)

# Semantic Scholar: higher rate limit
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# BioGRID interactions (ToolUniverse BioGRID_* tools)
# https://webservice.thebiogrid.org/  (request an access key)
BIOGRID_ACCESS_KEY=

# NVIDIA NIM: Evo 2 40B scoring (kif13a-atlas evo2_score) and ToolUniverse NvidiaNIM_* tools
# https://build.nvidia.com/  (sign in, Get API Key)
NVIDIA_API_KEY=

# EvolutionaryScale Forge: ESM C / ESM3 (ToolUniverse ESM_* tools)
# https://forge.evolutionaryscale.ai/
ESM_API_KEY=

# OMIM API (clinical synopsis; academic registration)
# https://www.omim.org/api
OMIM_API_KEY=

# Zotero web API: only needed for write access without Zotero 7 local write support
# https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=

# DECIPHER: not wired to any server yet (client key required, request via DECIPHER)
DECIPHER_CLIENT_KEY=
